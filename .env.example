# Copy to .env for local-only infrastructure. Never commit the populated file.
# Generate with a password manager or secrets manager; do not reuse these names as values.

# PostgreSQL used by the planned application layer and database/schema.sql.
POSTGRES_DB=bankhub
POSTGRES_USER=bankhub_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LOCAL_DEVELOPMENT_SECRET
DATABASE_URL=postgresql://bankhub_app:REPLACE_WITH_A_LOCAL_DEVELOPMENT_SECRET@localhost:5432/bankhub

# Required before a real OAuth/token-persistence implementation is enabled.
# 64 lowercase hexadecimal characters (32 bytes); use a unique value per environment.
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX_SECRET
CRON_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Reserved for the future provider adapters. Keep empty unless that adapter is implemented.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
